# Only needed for --method instaloader (the browser method uses ig_session.json
# from `python login.py` instead). Recommended: a throwaway account, not your
# main one — see README "Risks" section.
IG_USERNAME=

# Google Drive folder to upload downloaded outlier videos into.
# Open the target folder in Drive, copy the ID from the URL:
# https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_FOLDER_ID=
